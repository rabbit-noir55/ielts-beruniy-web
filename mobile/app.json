{
  "expo": {
    "name": "IELTS Beruniy",
    "slug": "ielts-beruniy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0A0A0B",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.ieltsberuniy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Davomat uchun QR kodni skanerlash kerak."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Davomat uchun joylashuvingiz kerak."
        }
      ]
    ]
  }
}
